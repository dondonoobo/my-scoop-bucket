{
    "version": "0.83.0.20250101",
    "description": "Japanese-localized version of PuTTY (SSH/Telnet client) by ranvis",
    "homepage": "https://www.ranvis.com/putty",
    "license": {
        "identifier": "MIT",
        "url": "https://www.chiark.greenend.org.uk/~sgtatham/putty/licence.html"
    },
    "notes": "Japanese-localized build of PuTTY maintained by ranvis.",
    "depends": "7zip",
    "architecture": {
        "64bit": {
            "url": "https://www.ranvis.com/downloads/PuTTY-0.83.0-ranvis-20250101.win64.7z",
            "extract_dir": "PuTTY"
        },
        "32bit": {
            "url": "https://www.ranvis.com/downloads/PuTTY-0.83.0-ranvis-20250101.win32.zip"
        }
    },
    "bin": [
        "putty.exe",
        "puttygen.exe",
        "pageant.exe",
        "plink.exe",
        "pscp.exe",
        "psftp.exe",
        "puttytel.exe"
    ],
    "shortcuts": [
        [
            "putty.exe",
            "PuTTY-ranvis"
        ]
    ],
    "persist": "putty.ini",
    "checkver": {
        "url": "https://www.ranvis.com/putty",
        "regex": "PuTTY-(?<Version>[\\d.]+)-ranvis-(?<Date>\\d{8})\\.win64\\.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.ranvis.com/downloads/PuTTY-$matchVersion-ranvis-$matchDate.win64.7z",
                "extract_dir": "PuTTY"
            },
            "32bit": {
                "url": "https://www.ranvis.com/downloads/PuTTY-$matchVersion-ranvis-$matchDate.win32.zip"
            }
        }
    }
}